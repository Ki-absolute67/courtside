{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Courtside",
  "version": "1.1.1",
  "identifier": "app.courtside.nba",
  "build": {
    "frontendDist": "../../extension"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Courtside",
        "url": "popup.html",
        "width": 980,
        "height": 760,
        "minWidth": 778,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Courtside",
    "shortDescription": "Live NBA scores, standings and your teams",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBRDkyMDJFMDlBNkQ2QzYKUldURzFxWUpMaURaMmtvRy9IZnRJUGw5ZldoMzNnTkJOSmIyY1hESXdUTytlOHJ0dVhhenM1QUgK",
      "endpoints": [
        "https://github.com/Ki-absolute67/courtside/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
